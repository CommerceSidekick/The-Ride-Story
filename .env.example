# Cloud mode (crew invites, shared trips, public book links). Leave both unset to run in local mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables "Rewrite text with AI" in the Book tab. Server-side only.
ANTHROPIC_API_KEY=

# Canonical site URL, used for link previews.
NEXT_PUBLIC_SITE_URL=https://theridestory.com

# Strava (optional). Create an app at https://www.strava.com/settings/api and set its
# Authorization Callback Domain to your site's domain (e.g. theridestory.com).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: separate secret for encrypting the Strava session cookie (defaults to one derived from the client secret).
STRAVA_TOKEN_SECRET=

# Encrypts every app connection's cookie (Wahoo, Polar, Ride with GPS, Instagram, Facebook). Any long random string.
TOKEN_SECRET=

# ---- Ride apps (each appears in the Collect tab once its keys are set). See docs/INTEGRATIONS.md ----
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
RWGPS_CLIENT_ID=
RWGPS_CLIENT_SECRET=
RWGPS_API_KEY=

# ---- Posting (Social tab) ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Temporary file storage for post images and print PDFs. Set automatically when you create a
# Vercel Blob store and connect it to the project (Vercel → Storage).
BLOB_READ_WRITE_TOKEN=

# ---- Printed books (Lulu prints and ships, Stripe takes payment) ----
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# "production" sends real print jobs; anything else uses Lulu's sandbox.
LULU_ENV=sandbox
# Optional: Lulu emails order updates here (defaults to the customer's email).
LULU_CONTACT_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price per copy in cents (never charged below Lulu's print cost + 10%).
BOOK_PRICE_CENTS=2500
