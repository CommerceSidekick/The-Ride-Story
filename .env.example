# Cloud mode (crew invites, shared trips, public book links). Leave both unset to run in local mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables "Rewrite text with AI" in the Book tab. Server-side only.
ANTHROPIC_API_KEY=

# Canonical site URL, used for link previews.
NEXT_PUBLIC_SITE_URL=https://theridestory.com

# Strava (optional). Create an app at https://www.strava.com/settings/api and set its
# Authorization Callback Domain to your site's domain (e.g. theridestory.com).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: separate secret for encrypting the Strava session cookie (defaults to one derived from the client secret).
STRAVA_TOKEN_SECRET=
